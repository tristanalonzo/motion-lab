#!/bin/sh
# Strips any Claude / Anthropic credit out of a commit message before the
# commit is made. Nothing from an assistant should ever show up on GitHub.
#
# Git runs this on every commit and hands it one argument: the path to a file
# holding the message. Whatever this script leaves in that file is what gets
# committed. So it rewrites the file and exits 0: it never blocks a commit, it
# just quietly takes the lines out. pre-push runs this same file as its check,
# so this is the only list of credit lines there is.
#
# Turn it on in a fresh clone with:  sh .githooks/setup
# (hooks aren't cloned with the repo, so each machine needs that once.)

msg="$1"

# grep -v keeps every line that does NOT match. -i ignores case, -E allows the
# (this|that) patterns, -a treats the message as text even with emoji in it.
#
# The patterns, in order:
#   1. any "Some-Label: ..." line naming either company: Co-Authored-By,
#      Signed-off-by, Assisted-by, Claude-Session and so on.
#   2. co-author lines with no hyphens, and ones from a bot or a noreply address.
#   3. "Generated with Claude", "made by Claude" and friends.
#   4. links back to either company.
#
# Each needs a whole credit line to match, not just the word "Claude", so an
# ordinary sentence that happens to mention Claude survives. A co-author line
# for a real person stays too.
grep -aivE \
  -e '^[[:space:]]*[a-z]+(-[a-z]+)+:.*(claude|anthropic)' \
  -e '^[[:space:]]*co-?authored-?by:.*(claude|anthropic|\[bot\]|noreply@)' \
  -e '(generated|created|written|authored|assisted|made|built|powered) (by|with).*(claude|anthropic)' \
  -e '(claude\.ai|claude\.com|anthropic\.com)' \
  "$msg" > "$msg.clean"

mv "$msg.clean" "$msg"
exit 0
